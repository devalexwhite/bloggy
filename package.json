{
	"name": "astro-sienna",
	"version": "0.2.0",
	"description": "A minimal Astro blog template — serif typography, dark mode, RSS, OG images, optional Giscus comments and analytics.",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/mdx": "5.0.4",
		"@astrojs/partytown": "^2.1.7",
		"@astrojs/react": "^5.0.7",
		"@astrojs/rss": "4.0.18",
		"@astrojs/sitemap": "3.7.2",
		"@astrojs/tailwind": "6.0.2",
		"@base-ui/react": "^1.5.0",
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@playform/compress": "^0.2.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"astro": "6.3.1",
		"astro-expressive-code": "^0.41.7",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-seo-schema": "^5.2.0",
		"astro-webmanifest": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cssnano": "^7.1.9",
		"hastscript": "^9.0.1",
		"katex": "^0.16.45",
		"lucide-react": "^1.17.0",
		"markdown-it": "^14.2.0",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"recharts": "3.8.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"sanitize-html": "^2.17.4",
		"satori": "0.15.2",
		"satori-html": "^0.3.2",
		"schema-dts": "^1.1.5",
		"shadcn": "^4.11.0",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.4.15",
		"@iconify-json/mdi": "^1.2.3",
		"@resvg/resvg-js": "^2.6.2",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"autoprefixer": "^10.5.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"rehype-unwrap-images": "^1.0.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.34.5"
		}
	}
}
