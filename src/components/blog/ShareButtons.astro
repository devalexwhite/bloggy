---
interface Props {
	title: string;
	url: string;
	description?: string;
}

const { title, url, description } = Astro.props;

const tweetText = description ? `${title} — ${description}` : title;
const twitterHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
	tweetText,
)}&url=${encodeURIComponent(url)}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
	url,
)}`;
const mastodonHref = `https://share.joinmastodon.org/#text=${encodeURIComponent(url)}`;
---

<div class="share">
	<span class="share-label">Share</span>
	<div class="share-buttons">
        <a
          class="share-btn"
          href={mastodonHref}
          target="_blank"
          rel="noopener"
          aria-label="Share on Mastodon"
        >
          <svg width="14" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M433 179.1c0-97.2-63.7-125.7-63.7-125.7-62.5-28.7-228.6-28.4-290.5 0 0 0-63.7 28.5-63.7 125.7 0 115.7-6.6 259.4 105.6 289.1 40.5 10.7 75.3 13 103.3 11.4 50.8-2.8 79.3-18.1 79.3-18.1l-1.7-36.9s-36.3 11.4-77.1 10.1c-40.4-1.4-83-4.4-89.6-54-.6-4.6-.9-9.3-.9-13.9 85.6 20.9 158.7 9.1 178.7 6.7 56.1-6.7 105-41.3 111.2-72.9 9.8-49.8 9-121.5 9-121.5zM357.9 304.3l-46.6 0 0-114.2c0-49.7-64-51.6-64 6.9l0 62.5-46.3 0 0-62.5c0-58.5-64-56.6-64-6.9l0 114.2-46.7 0c0-122.1-5.2-147.9 18.4-175 25.9-28.9 79.8-30.8 103.8 6.1l11.6 19.5 11.6-19.5c24.1-37.1 78.1-34.8 103.8-6.1 23.7 27.3 18.4 53 18.4 175l0 0z"/></svg>

          <span>Mastodon</span>
        </a>

		<a
			class="share-btn"
			href={twitterHref}
			target="_blank"
			rel="noopener"
			aria-label="Share on X (Twitter)"
		>
			<svg
				aria-hidden="true"
				focusable="false"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M4 4l7.5 9.5L4.5 20H7l5.5-5.5L17 20h3l-7.8-9.9L19.5 4H17l-4.8 5.2L8 4H4z"></path>
			</svg>
			<span>X</span>
		</a>

		<a
			class="share-btn"
			href={linkedinHref}
			target="_blank"
			rel="noopener"
			aria-label="Share on LinkedIn"
		>
			<svg
				aria-hidden="true"
				focusable="false"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<rect x="3" y="3" width="18" height="18" rx="2"></rect>
				<line x1="8" y1="10" x2="8" y2="17"></line>
				<circle cx="8" cy="7" r="0.6" fill="currentColor"></circle>
				<path d="M12 17v-4a2 2 0 0 1 4 0v4"></path>
				<line x1="12" y1="10" x2="12" y2="17"></line>
			</svg>
			<span>LinkedIn</span>
		</a>

		<button
			class="share-btn share-copy"
			type="button"
			data-share-copy
			data-url={url}
			aria-label="Copy link"
		>
			<svg
				aria-hidden="true"
				focusable="false"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
			</svg>
			<span class="share-copy-label">Link</span>
		</button>
	</div>
</div>

<style>
	.share {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
		max-width: var(--reading-width);
		margin: 48px 0 0;
	}
	.share-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.72);
	}
	.share-buttons {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: hsl(var(--theme-accent));
		background: var(--accent-soft);
		padding: 4px 10px;
		border: 1px solid transparent;
		border-radius: 999px;
		cursor: pointer;
		text-decoration: none;
		line-height: 1.4;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.share-btn:hover,
	.share-btn:focus-visible {
		color: hsl(var(--theme-bg));
		background: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
	}
	.share-btn:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
	}
	.share-btn svg {
		display: inline-block;
		flex-shrink: 0;
	}
	.share-copy[data-copied="true"] {
		background: hsl(var(--theme-accent));
		color: hsl(var(--theme-bg));
		border-color: hsl(var(--theme-accent));
	}

	@media (max-width: 420px) {
		.share { gap: 10px; }
		.share-btn { padding: 4px 8px; font-size: 10.5px; }
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-share-copy]").forEach((btn) => {
		const label = btn.querySelector<HTMLElement>(".share-copy-label");
		const original = label?.textContent ?? "Copy link";
		const originalAria = btn.getAttribute("aria-label") ?? "Copy link";

		btn.addEventListener("click", async () => {
			const url = btn.dataset.url ?? window.location.href;
			try {
				await navigator.clipboard.writeText(url);
			} catch {
				const input = document.createElement("input");
				input.value = url;
				document.body.appendChild(input);
				input.select();
				try {
					// @ts-ignore: document.execCommand is deprecated but used as a fallback
					document.execCommand("copy");
				} catch {}
				input.remove();
			}
			btn.dataset.copied = "true";
			btn.setAttribute("aria-label", "Copied");
			if (label) label.textContent = "Copied!";
			setTimeout(() => {
				delete btn.dataset.copied;
				btn.setAttribute("aria-label", originalAria);
				if (label) label.textContent = original;
			}, 1500);
		});
	});
</script>
