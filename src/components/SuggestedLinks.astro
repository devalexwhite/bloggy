---
interface Link {
	title: string;
	url: string;
    icon?: string;
}

interface Props {
	links: Link[];
}

const { links = [] } = Astro.props;
---

{links.length > 0 && (
	<div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			{links.map((link) => {
				const isExternal = link.url.startsWith('http');
				return (
					<a
						href={link.url}
						target={isExternal ? '_blank' : undefined}
						rel={isExternal ? 'noopener noreferrer' : undefined}
						class="group relative flex items-center gap-1 justify-start transition-all duration-300 hover:translate-x-1 hover:border-indigo-500/30 dark:hover:border-indigo-400/30 overflow-hidden"
					>
                        {isExternal && (
                          <div class="pr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 ml-2">
                            <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" />
                            <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" />
                          </svg>
                          </div>
                        )}

                        {!isExternal && link.icon  && (
                          <div class="pr-2" set:html={link.icon}>
                          </div>
                        )}

                        {
                          !isExternal &&  !link.icon && (
                            <div class="pr-2">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                              </svg>
                            </div>
                          )
                        }

						<span class="relative font-medium text-gray-700 dark:text-gray-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-300">
							{link.title}
						</span>
					</a>
				);
			})}
		</div>
	</div>
)}
